NODE_ENV=production
PORT=3000
BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=your_telegram_user_id
DATABASE_URL=postgresql://user:password@host:port/database
PUBLIC_WEBHOOK_URL=

# Binance transfer verification (read-only account API key)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_PAY_ID=your_binance_pay_id
BINANCE_API_BASE_URL=https://api.binance.com

# Optional Binance Pay merchant API. Leave disabled unless you use merchant checkout.
BINANCE_PAY_MERCHANT_ENABLED=false
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=

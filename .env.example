NODE_ENV=production
PORT=3000
BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN_HERE
ADMIN_IDS=PUT_ADMIN_TELEGRAM_ID_HERE
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SCHEMA=public

# Recommended: generate once and never change it after stock has been encrypted.
# Example command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVENTORY_ENCRYPTION_KEY=

# Binance ID verification — normal Binance account API key, READ permission only.
BINANCE_API_KEY=PUT_NORMAL_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=PUT_NORMAL_BINANCE_API_SECRET_HERE
BINANCE_PAY_ID=PUT_BINANCE_ID_HERE
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_MIN_AMOUNT=0.01
BINANCE_MAX_AMOUNT=100000
BINANCE_VERIFY_WINDOW_HOURS=6

# SuperQi / IQD
SUPERQI_NUMBER=917392710336
IQD_RATE=1500

SUPPORT_USERNAME=e_nnbot
DEFAULT_LANGUAGE=ar
CAPTCHA_ENABLED=false

# ==============================
# Shared multi-bot network (v11 — fair commission + debt protection)
# ==============================
# Main/original bot:
NETWORK_ROLE=master
NETWORK_PUBLIC_URL=
NETWORK_OWNER_NAME=نبيل
NETWORK_SETTLEMENT_CURRENCY=USD
EGP_RATE_PER_USD=50

# Partner/client bot only (leave empty on master):
NETWORK_API_URL=
NETWORK_API_KEY=
NETWORK_SHOP_ID=
NETWORK_SHOP_NAME=

# Cross-shop fairness rules
# If Shop A sells stock owned by Shop B, A keeps this percentage and B gets the rest.
NETWORK_SELLER_COMMISSION_PERCENT=10
# Open-debt reminder cadence for the debtor admin.
NETWORK_DEBT_REMINDER_MINUTES=30
NETWORK_DEBT_REMINDER_THRESHOLD_USD=15
# At or above this total liability, new customer sales/topups pause until confirmed settlement.
NETWORK_DEBT_SUSPEND_THRESHOLD_USD=40

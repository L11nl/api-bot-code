NODE_ENV=production
PORT=3000
BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN_HERE
# Bootstrap admin. Add more admins later from /admin > Settings > Admin management.
ADMIN_IDS=PUT_ADMIN_TELEGRAM_ID_HERE
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Recommended: generate once and never change it after stock has been encrypted.
# Example command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVENTORY_ENCRYPTION_KEY=

# Binance ID verification — normal Binance account API key, READ permission only.
BINANCE_API_KEY=PUT_NORMAL_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=PUT_NORMAL_BINANCE_API_SECRET_HERE
BINANCE_PAY_ID=PUT_BINANCE_ID_HERE
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_MIN_AMOUNT=0.01
BINANCE_MAX_AMOUNT=100000
BINANCE_VERIFY_WINDOW_HOURS=6

# SuperQi / IQD
SUPERQI_NUMBER=917392710336
IQD_RATE=1500

SUPPORT_USERNAME=e_nnbot
DEFAULT_LANGUAGE=ar
CAPTCHA_ENABLED=false
# Virtual numbers — optional. You can also add/remove both API keys from /admin.
# If both are empty/disabled, the virtual-number button is hidden from customers.
SMSBOWER_API_KEY=
SMSBOWER_BASE_URL=https://smsbower.page/stubs/handler_api.php
SMSMAN_API_KEY=
SMSMAN_BASE_URL=https://api.sms-man.com/stubs/handler_api.php
GRIZZLYSMS_API_KEY=
GRIZZLYSMS_BASE_URL=https://api.grizzlysms.com/stubs/handler_api.php
VIRTUAL_NUMBERS_TIMEOUT_MS=12000
VIRTUAL_NUMBERS_POLL_INTERVAL_MS=7000

